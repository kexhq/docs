package "docs" do
  version("0.1.0")
  description("The source of docs.kex.run: the Kex guide and landing page, written with Marqraft")
  kex(">= 0.4.0-beta.2")
  license("MIT")

  # Project commands, run as "tey NAME" and listed by "tey help". They expect
  # Marqraft's `marq` on PATH, as the README does.
  command("dev", run: "marq dev .",
          description: "Edit the site in the browser at http://localhost:4173")
  command("site", run: "marq build . && tey finish",
          description: "Build the whole site into dist/, as the publish workflow does")
  command("finish", run: "scripts/finish.kex .",
          description: "Write llms.txt, sitemap.xml, robots.txt and CNAME into dist/")
end
